<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@include file="helpers.jspf"%>
<%String base=request.getContextPath();List<String[]> roles=(List<String[]>)request.getAttribute("roles");String[] editando=(String[])request.getAttribute("rolEditando");Object token=session.getAttribute("csrf");%>
<div class="page-heading"><div><span class="eyebrow">SEGURIDAD</span><h1>Roles y acceso</h1><p class="muted">ADMINISTRADOR gestiona cuentas. Los demás perfiles acceden al inicio.</p></div><a class="button" href="<%=base%>/roles?nuevo=1">＋ Nuevo rol</a></div>
<%if(editando!=null){%><form class="card editor" method="post" action="<%=base%>/roles"><input type="hidden" name="csrf" value="<%=esc(token)%>"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="<%=esc(editando[0])%>"><h2><%="0".equals(editando[0])?"Nuevo rol":"Editar rol"%></h2><div class="form-grid"><%=campo("Nombre del rol","nombre",editando[1],"text",30,true)%><%=campo("Descripción","descripcion",editando[2],"text",150,false)%></div><div class="form-actions"><button>Guardar rol</button><a href="<%=base%>/roles">Cancelar</a></div></form><%}%>
<section class="card tablecard"><h2>Roles registrados</h2><div class="scroll"><table><thead><tr><th>Rol</th><th>Descripción</th><th>Acciones</th></tr></thead><tbody>
<%for(String[] r:roles){%><tr><td><strong><%=esc(r[1])%></strong></td><td><%=esc(r[2])%></td><td><a href="<%=base%>/roles?editar=<%=esc(r[0])%>">Editar</a><%if(!"ADMINISTRADOR".equals(r[1])&&!"OPERADOR".equals(r[1])){%><details><summary>Eliminar</summary><p>Solo se puede eliminar un rol sin usuarios asignados.</p><%=accion(base,token,Integer.parseInt(r[0]),"/roles","eliminar","Confirmar eliminación")%></details><%}%></td></tr><%}%>
</tbody></table></div><p class="small muted">Los roles ADMINISTRADOR y OPERADOR son perfiles base y no pueden eliminarse.</p></section>
