<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.mycompany.novatech.app.*,com.mycompany.novatech.app.comercial.*,com.mycompany.novatech.app.reportes.*,java.util.*"%>
<% String base=request.getContextPath();String csrf=AppServlet.e(session.getAttribute("csrf"));CompraRepository.Compra compra=(CompraRepository.Compra)request.getAttribute("compra"); %>
<link rel="stylesheet" href="<%=base%>/assets/reportes/reportes.css">
<div class="page-heading"><div><h1>Compras a proveedores</h1><p>Registra la orden, recibe los artículos y confirma el pago.</p></div><a class="button" href="<%=base%>/compras?nuevo=1">Nueva compra</a></div>
<%if(request.getParameter("nuevo")!=null){%>
<form class="card editor" method="post" action="<%=base%>/compras?nuevo=1">
<input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="accion" value="registrar"><input type="hidden" name="clave" value="<%=AppServlet.e(request.getAttribute("claveCompra"))%>">
<div class="form-grid"><label>Proveedor<select name="proveedor" required><option value="">Selecciona</option><%for(Proveedor p:(List<Proveedor>)request.getAttribute("proveedoresCompra")){if(p.activo){%><option value="<%=p.id%>" <%=String.valueOf(p.id).equals(request.getParameter("proveedor"))?"selected":""%>><%=AppServlet.e(p.razonSocial)%></option><%}}%></select></label>
<label>Fecha prevista de entrega<input type="date" name="prevista" required value="<%=AppServlet.e(request.getParameter("prevista"))%>"></label>
<label>Observación<input name="observacion" maxlength="500" value="<%=AppServlet.e(request.getParameter("observacion"))%>"></label></div>
<p class="muted">El costo unitario es el importe final de adquisición en soles. Completa las líneas que necesites. La recepción registra la entrega completa y actualiza el stock de productos e insumos.</p>
<div class="scroll"><table class="purchase-lines"><thead><tr><th>Artículo</th><th>Cantidad</th><th>Costo unitario S/</th></tr></thead><tbody id="lineas-compra">
<%String[] ps=request.getParameterValues("producto"),qs=request.getParameterValues("cantidad"),cs=request.getParameterValues("costo");int n=ps==null?1:Math.min(ps.length,20);for(int i=0;i<n;i++){%><tr><td><select name="producto"><option value="">Selecciona un artículo</option><%for(Producto p:(List<Producto>)request.getAttribute("productosCompra")){if(p.activo){%><option value="<%=p.id%>" <%=ps!=null&&String.valueOf(p.id).equals(ps[i])?"selected":""%>><%=AppServlet.e(p.codigo+" · "+p.nombre)%></option><%}}%></select></td><td><input type="number" name="cantidad" step="0.001" min="0.001" value="<%=AppServlet.e(qs!=null&&i<qs.length?qs[i]:"1")%>"></td><td><input type="number" name="costo" step="0.01" min="0" value="<%=AppServlet.e(cs!=null&&i<cs.length?cs[i]:"")%>"></td></tr><%}%>
</tbody></table></div><div class="form-actions"><button type="button" class="secondary" id="agregar-compra">Agregar artículo</button><button>Registrar compra</button><a href="<%=base%>/compras">Cancelar</a></div>
</form><script src="<%=base%>/assets/reportes/compras.js" defer></script><%}%>
<%if(compra!=null){%><section class="card editor"><h2>Compra C-<%=compra.id%> · <%=AppServlet.e(compra.estado)%></h2>
<p><strong><%=AppServlet.e(compra.nombre)%></strong> · Total S/ <%=compra.total%></p><p>Entrega prevista <%=compra.prevista%>. Recepción <%=compra.recepcion==null?"pendiente":AppServlet.e(compra.recepcion)%>. Pago <%=compra.pago==null?"pendiente":AppServlet.e(compra.pago)%>.</p>
<p><%=AppServlet.e(compra.observacion)%></p><div class="scroll"><table><thead><tr><th>Artículo</th><th>Cantidad</th><th>Costo S/</th><th>Importe S/</th></tr></thead><tbody><%for(CompraRepository.Linea l:compra.lineas){%><tr><td><%=AppServlet.e(l.nombre)%></td><td><%=l.cantidad%></td><td><%=l.costo%></td><td><%=l.subtotal%></td></tr><%}%></tbody></table></div>
<%if("PENDIENTE".equals(compra.estado)){%><form method="post" action="<%=base%>/compras"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=compra.id%>"><input type="hidden" name="version" value="<%=compra.version%>"><label>Evaluación de la entrega<select name="evaluacion" required><option value="">Selecciona</option><%for(int i=1;i<=5;i++){%><option value="<%=i%>"><%=i%> de 5</option><%}%></select></label><button name="accion" value="recibir">Confirmar recepción completa</button></form>
<details><summary>Anular esta compra</summary><p>Se conservará el historial de la orden anulada.</p><form method="post" action="<%=base%>/compras"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=compra.id%>"><input type="hidden" name="version" value="<%=compra.version%>"><button name="accion" value="anular" class="secondary">Confirmar anulación</button></form></details>
<%}else if("RECIBIDA".equals(compra.estado)&&compra.pago==null){%><form method="post" action="<%=base%>/compras"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=compra.id%>"><input type="hidden" name="version" value="<%=compra.version%>"><p>Confirma el pago completo de S/ <%=compra.total%> al proveedor.</p><button name="accion" value="pagar">Registrar pago completo</button></form><%}%>
</section><%}%>
<section class="card"><h2>Órdenes de compra</h2><p class="small muted">Últimas 500 órdenes. Consulta los reportes de proveedores para períodos mayores.</p><div class="scroll"><table><thead><tr><th>Compra</th><th>Proveedor</th><th>Registro</th><th>Estado</th><th>Pago</th><th>Total S/</th><th>Acciones</th></tr></thead><tbody>
<%for(CompraRepository.Compra x:(List<CompraRepository.Compra>)request.getAttribute("compras")){%><tr><td>C-<%=x.id%></td><td><%=AppServlet.e(x.nombre)%></td><td><%=AppServlet.e(x.fecha)%></td><td><%=x.estado%></td><td><%=x.pago==null?"Pendiente":"Pagada"%></td><td><%=x.total%></td><td><a href="<%=base%>/compras?ver=<%=x.id%>">Ver compra</a></td></tr><%}%>
</tbody></table></div></section>
