<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@include file="helpers.jspf"%>
<%String base=request.getContextPath(),clase=(String)request.getAttribute("claseCatalogo");String[] f=(String[])request.getAttribute("catalogoForm");Object token=session.getAttribute("csrf");%>
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO COMERCIAL</span><h1>Catálogos de productos</h1><p><a href="<%=base%>/productos">Volver a productos y servicios</a></p></div></div>
<nav class="contact-tabs" aria-label="Catálogos"><%String[] keys={"categoria","marca","unidad"},labels={"Categorías","Marcas","Unidades de medida"};for(int i=0;i<3;i++){%><a class="button <%=clase.equals(keys[i])?"":"secondary"%>" href="<%=base%>/catalogos-productos?clase=<%=keys[i]%>"><%=labels[i]%></a><%}%></nav>
<form class="card editor" method="post" action="<%=base%>/catalogos-productos"><h2><%="0".equals(f[0])?"Nuevo registro":"Editar registro"%></h2><input type="hidden" name="csrf" value="<%=esc(token)%>"><input type="hidden" name="id" value="<%=esc(f[0])%>"><input type="hidden" name="clase" value="<%=clase%>"><input type="hidden" name="accion" value="guardar"><%=campo("Nombre","nombre",f[1],"text",100,true)%><label class="check"><input type="checkbox" name="activo" <%="1".equals(f[2])?"checked":""%>>Registro activo</label><div class="form-actions"><button>Guardar catálogo</button><a href="<%=base%>/catalogos-productos?clase=<%=clase%>">Limpiar formulario</a></div></form>
<section class="card"><div class="scroll"><table><thead><tr><th>Nombre</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><%for(String[] c:(List<String[]>)request.getAttribute("catalogosComerciales")){%><tr><td><%=esc(c[1])%></td><td><%="1".equals(c[2])?"Activo":"Inactivo"%></td><td><a href="<%=base%>/catalogos-productos?clase=<%=clase%>&amp;editar=<%=esc(c[0])%>">Editar</a><details><summary>Eliminar</summary><p>Solo se elimina si ningún artículo lo utiliza.</p><form method="post" action="<%=base%>/catalogos-productos"><input type="hidden" name="csrf" value="<%=esc(token)%>"><input type="hidden" name="clase" value="<%=clase%>"><input type="hidden" name="id" value="<%=esc(c[0])%>"><input type="hidden" name="accion" value="eliminar"><button class="secondary">Confirmar eliminación</button></form></details></td></tr><%}%></tbody></table></div></section>
